{
  "name": "creator-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @creator-platform/web",
    "build": "npm run build --workspace @creator-platform/web && npm run typecheck --workspace @creator-platform/api",
    "typecheck": "npm run typecheck --workspace @creator-platform/api",
    "test": "node --test tests/*.test.mjs",
    "deploy:api": "wrangler deploy --config apps/api/wrangler.toml"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
